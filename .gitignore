# Generated JetSetCraft production assets; rebuilt by tools/generate_models.py in CI.
src/main/resources/assets/jetsetcraft/models/obj/*.obj
src/main/resources/assets/jetsetcraft/models/obj/*.mtl
src/main/resources/assets/jetsetcraft/textures/item/*.png
src/main/resources/assets/jetsetcraft/textures/graffiti/tag_*.png

__pycache__/
*.pyc

# Owner-supplied brand source stays in durable project storage. Public generated banner/icon derivatives
# are committed because README and repository identity must render before any local generator is run.
src/main/resources/jetsetcraft.png
src/main/resources/assets/jetsetcraft/textures/graffiti/jsr/*.png
src/main/resources/assets/jetsetcraft/graffiti/catalog.json
# Full-resolution masters are stored and verified in JetSetCraft/Assets on Google Drive.
source_assets/brand/jetsetcraft_official_art.png

# Owner-supplied and research-only binary inputs are part of the canonical Desktop/Drive project,
# but are intentionally excluded from the public Git repository and release JAR.
source_assets/authorized/jsr/JSRGraffiti.zip
source_assets/authorized/red-skate/*.jar
source_assets/references/bedrock/*.zip
source_assets/references/jsr-models/*.zip
