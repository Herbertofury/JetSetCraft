diff --git a/tools/validate_gang_custom_dimension_affinity.py b/tools/validate_gang_custom_dimension_affinity.py
new file mode 100644
index 0000000000000000000000000000000000000000..b9c0e8d59f68b0960bed541df9c286fdb09cda75
--- /dev/null
+++ b/tools/validate_gang_custom_dimension_affinity.py
@@ -0,0 +1,168 @@
+#!/usr/bin/env python3
+"""Regression gate for custom-dimension gang fallback through the real production method.
+
+No Forge installation is required for this contract gate. Native Forge GameTests
+remain mandatory for full acceptance.
+"""
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+PRODUCTION = ROOT / 'src/main/java/com/herberto/jetsetcraft/gang/GangDimensionPolicy.java'
+STUBS = {
+    'net/minecraft/resources/ResourceKey.java': '''package net.minecraft.resources;
+public final class ResourceKey<T> {
+    private final String value;
+    public ResourceKey(String value) { this.value = value; }
+    @Override public String toString() { return value; }
+}
+''',
+    'net/minecraft/resources/ResourceLocation.java': '''package net.minecraft.resources;
+public final class ResourceLocation {
+    public static final String DEFAULT_NAMESPACE = "minecraft";
+    private final String namespace;
+    private final String path;
+    private ResourceLocation(String namespace, String path) {
+        this.namespace = namespace;
+        this.path = path;
+    }
+    public static ResourceLocation fromNamespaceAndPath(String namespace, String path) {
+        return new ResourceLocation(namespace, path);
+    }
+    public String getNamespace() { return namespace; }
+    public String getPath() { return path; }
+}
+''',
+    'net/minecraft/world/level/Level.java': '''package net.minecraft.world.level;
+import net.minecraft.resources.ResourceKey;
+public final class Level {
+    public static final ResourceKey<Level> OVERWORLD = new ResourceKey<>("overworld");
+    public static final ResourceKey<Level> NETHER = new ResourceKey<>("nether");
+    public static final ResourceKey<Level> END = new ResourceKey<>("end");
+    public static final ResourceKey<Level> CUSTOM = new ResourceKey<>("custom");
+    public static final ResourceKey<Level> CUSTOM_NETHER = new ResourceKey<>("addon:nether_mirror");
+    public static final ResourceKey<Level> CUSTOM_END = new ResourceKey<>("addon:end_mirror");
+}
+''',
+}
+PROBE = '''import com.herberto.jetsetcraft.gang.GangDimensionPolicy;
+import net.minecraft.resources.ResourceKey;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.world.level.Level;
+import java.util.List;
+import java.util.Random;
+
+public final class GangDimensionPolicyProbe {
+    private static final List<String> NETHER_EXCLUSIVE = List.of("piglin", "piglin_brute", "zombified_piglin", "hoglin", "zoglin", "blaze", "ghast", "magma_cube", "strider", "wither_skeleton");
+    private static final List<String> NETHER_SHARED = List.of("skeleton", "enderman");
+    private static final List<String> END = List.of("enderman", "shulker");
+    private static int checks;
+    private static boolean reference(ResourceKey<Level> dimension, ResourceLocation id) {
+        if (dimension == null || id == null) return false;
+        if (!"minecraft".equals(id.getNamespace())) return true;
+        String path = id.getPath();
+        if (dimension == Level.NETHER) return NETHER_EXCLUSIVE.contains(path) || NETHER_SHARED.contains(path);
+        if (dimension == Level.END) return END.contains(path);
+        if (dimension == Level.OVERWORLD) return !NETHER_EXCLUSIVE.contains(path) && !"shulker".equals(path);
+        return true;
+    }
+    private static void check(ResourceKey<Level> dimension, ResourceLocation id) {
+        boolean actual = GangDimensionPolicy.allows(dimension, id);
+        boolean expected = reference(dimension, id);
+        if (actual != expected) {
+            throw new AssertionError("dimension=" + dimension + ", entity=" +
+                (id == null ? "null" : id.getNamespace() + ":" + id.getPath()) +
+                ", expected=" + expected + ", actual=" + actual);
+        }
+        checks++;
+    }
+    public static void main(String[] args) {
+        ResourceKey<Level>[] dims = new ResourceKey[] {Level.OVERWORLD, Level.NETHER, Level.END, Level.CUSTOM, Level.CUSTOM_NETHER, Level.CUSTOM_END, null};
+        List<String> paths = List.of("skeleton", "enderman", "shulker", "piglin", "piglin_brute", "zombified_piglin", "hoglin", "zoglin", "blaze", "ghast", "magma_cube", "strider", "wither_skeleton", "zombie", "creeper", "cow", "witch", "snow_golem", "stray", "endermite", "warden", "bogged");
+        for (ResourceKey<Level> dimension : dims) {
+            check(dimension, null);
+            for (String path : paths) {
+                check(dimension, ResourceLocation.fromNamespaceAndPath("minecraft", path));
+                check(dimension, ResourceLocation.fromNamespaceAndPath("example", path));
+            }
+        }
+        // Deterministic, broad regression test for the full old contract's unrelated lanes.
+        Random rng = new Random(142L);
+        for (int i = 0; i < 50000; i++) {
+            ResourceKey<Level> dimension = dims[rng.nextInt(dims.length)];
+            String path = paths.get(rng.nextInt(paths.size()));
+            String ns = rng.nextInt(5) == 0 ? "minecraft" : "crossmod";
+            check(dimension, ResourceLocation.fromNamespaceAndPath(ns, path));
+        }
+        if (checks < 50200) throw new AssertionError("Insufficient coverage: " + checks);
+        System.out.println("PASS " + checks + " Java 17-compatible production GangDimensionPolicy assertions");
+    }
+}
+'''
+
+MUTANTS = {
+    'nether_skeleton_missing': ('List.of("skeleton", "enderman")', 'List.of("enderman")'),
+    'nether_enderman_missing': ('List.of("skeleton", "enderman")', 'List.of("skeleton")'),
+    'nether_everything_allowed': ('NETHER_VANILLA.contains(path) || NETHER_SHARED.contains(path)', 'true'),
+    'overworld_skeleton_enderman_removed': ('if (dimension == Level.OVERWORLD) return !NETHER_VANILLA.contains(path) && !"shulker".equals(path);', 'if (dimension == Level.OVERWORLD) return !NETHER_VANILLA.contains(path) && !NETHER_SHARED.contains(path) && !"shulker".equals(path);'),
+    'end_enderman_removed': ('if (dimension == Level.END) return END_VANILLA.contains(path);', 'if (dimension == Level.END) return "shulker".equals(path);'),
+    'modded_mobs_rejected': ('if (!ResourceLocation.DEFAULT_NAMESPACE.equals(entityId.getNamespace())) return true;', 'if (!ResourceLocation.DEFAULT_NAMESPACE.equals(entityId.getNamespace())) return false;'),
+    'custom_dimensions_treated_as_overworld': ('if (dimension == Level.OVERWORLD) return !NETHER_VANILLA.contains(path) && !"shulker".equals(path);', 'if (dimension == Level.OVERWORLD || dimension == Level.CUSTOM) return !NETHER_VANILLA.contains(path) && !"shulker".equals(path);'),
+}
+
+
+def run_java(source: str) -> tuple[bool, str]:
+    with tempfile.TemporaryDirectory(prefix='jsc-dimension-policy-') as tmp:
+        base = Path(tmp)
+        files = dict(STUBS)
+        files['com/herberto/jetsetcraft/gang/GangDimensionPolicy.java'] = source
+        files['GangDimensionPolicyProbe.java'] = PROBE
+        paths = []
+        for relative, content in files.items():
+            dest = base / relative
+            dest.parent.mkdir(parents=True, exist_ok=True)
+            dest.write_text(content, encoding='utf-8')
+            paths.append(str(dest))
+        compiled = subprocess.run(['javac', '--release', '17', '-encoding', 'UTF-8', '-d', str(base), *paths], capture_output=True, text=True, timeout=30)
+        if compiled.returncode:
+            raise RuntimeError('javac --release 17 failed: ' + (compiled.stderr or compiled.stdout))
+        ran = subprocess.run(['java', '-cp', str(base), 'GangDimensionPolicyProbe'], capture_output=True, text=True, timeout=30)
+        return ran.returncode == 0, (ran.stdout + ran.stderr).strip()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--no-mutations', action='store_true')
+    args = parser.parse_args()
+    source = PRODUCTION.read_text(encoding='utf-8')
+    success, evidence = run_java(source)
+    print('BASELINE ' + evidence)
+    if not success:
+        raise SystemExit(1)
+    if not args.no_mutations:
+        rejected = 0
+        for name, (old, new) in MUTANTS.items():
+            if source.count(old) != 1:
+                raise AssertionError('Mutant no longer targets one production expression: ' + name)
+            candidate = source.replace(old, new, 1)
+            passed, details = run_java(candidate)
+            if passed:
+                raise AssertionError('Adversarial mutation survived: ' + name)
+            if 'AssertionError' not in details:
+                raise AssertionError('Mutant failed for unrelated reason: ' + name + ' ' + details)
+            rejected += 1
+        custom_false = source.rsplit('return true;', 1)
+        if len(custom_false) != 2:
+            raise AssertionError('Missing custom dimension acceptance return')
+        passed, details = run_java('return false;'.join(custom_false))
+        if passed or 'AssertionError' not in details:
+            raise AssertionError('Custom dimension denial mutation survived or failed unexpectedly: ' + details)
+        rejected += 1
+        print(f'PASS {rejected}/{len(MUTANTS) + 1} adverse mutations rejected by production contract')
+
+if __name__ == '__main__':
+    main()
